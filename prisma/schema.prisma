generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id             String  @id @default(cuid())
  name           String  @unique
  label          String
  selfAssignable Boolean @default(true)
  users          User[]

  @@map("UserRole")
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  phone             String?
  passwordHash      String
  roleId            String
  role              Role               @relation(fields: [roleId], references: [id])
  university        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  studentPreference StudentPreference?
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  accommodations Accommodation[] @relation("LandlordAccommodations")

  @@index([roleId])
}

model Accommodation {
  id             String              @id @default(cuid())
  landlordId     String
  description    String
  area           String
  price          Int
  propertyType   PropertyType
  amenities      String[]            @default([])
  availableFrom  DateTime?
  status         AccommodationStatus @default(PENDING_REVIEW)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  latitude       Float
  longitude      Float
  photos         String[]            @default([])
  roomIdentifier String?             @map("roomName")

  landlord      User           @relation("LandlordAccommodations", fields: [landlordId], references: [id])
  notifications Notification[]
}

model University {
  id                 String              @id @default(cuid())
  name               String
  latitude           Float?
  longitude          Float?
  studentPreferences StudentPreference[]
}

model StudentPreference {
  id           String        @id @default(cuid())
  studentId    String        @unique
  universityId String?
  propertyType PropertyType?
  priceRange   String
  maxDistance  Float         @default(0)
  ratings      Json
  minMatch     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student    User        @relation(fields: [studentId], references: [id])
  university University? @relation(fields: [universityId], references: [id])
}

model Notification {
  id              String   @id @default(cuid())
  studentId       String
  accommodationId String
  title           String
  message         String
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@unique([studentId, accommodationId])
  @@index([studentId, read, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  studentId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

enum PropertyType {
  SINGLE_ROOM
  DOUBLE
  COMMUNE
  BACHELOR
}

enum AccommodationStatus {
  AVAILABLE
  OCCUPIED
  VERIFIED
  PENDING_REVIEW
  INACTIVE
}